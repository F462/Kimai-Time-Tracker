{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "rootDir": ".",
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": [
    "*.js",
    "**/*.js",
    "**/*.mjs",
    "**/*.ts",
    "**/*.tsx",
    "eslint.config.mjs",
    ".prettierrc.js"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ]
}
